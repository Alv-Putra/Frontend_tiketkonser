# Salin ke .env.local lalu sesuaikan.

# Alamat backend (repo Dipsii1/Backend_UKK). Request /api/* dari frontend
# diteruskan ke sini oleh Next.js, jadi tidak perlu mengatur CORS.
BACKEND_API_URL=http://localhost:5000

# Alamat Socket.IO backend untuk status kursi realtime (koneksi websocket langsung, bukan lewat proxy Next).
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
